# Copy to .env and fill in. Never commit the real .env — it holds a live API token.
DT_OTLP_ENDPOINT=https://<your-tenant-id>.live.dynatrace.com/api/v2/otlp
DT_API_TOKEN=dt0c01.xxxx
TRACE_MODE=v1                       # v1 direct | v2 Bindplane | v3 OneAgent
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b
LLM_MODEL_BIG=qwen2.5:3b
EMBED_MODEL=nomic-embed-text        # ollama pull nomic-embed-text
PORT=8082
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_PATH=./.chroma-v6
DOCS_DIR=./kb                       # the knowledge base the docs route answers from
# CACHE_THRESHOLD=0.92              # cosine >= this = semantic cache hit
# RAG_THRESHOLD=0.35               # min cosine for a doc chunk to count as relevant
# CONV_MAX=40                      # messages kept per conversation
# CONV_TTL=86400                   # seconds a conversation lives after last turn
